# ---- Server ----
PORT=3000
# Public URL of the app. Must match the redirect URI in Google Cloud:
#   <BASE_URL>/auth/google/callback
BASE_URL=http://localhost:3000
# Set to 1 only when running behind a reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=0

# ---- Security ----
# 64 hex chars (32 bytes). `npm run setup` generates one for you.
# Encrypts Gmail tokens and uploaded resumes at rest. Never commit or share it.
ENCRYPTION_KEY=

# ---- Google OAuth (Sign in + Gmail send) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI (pick one; leave both empty to use built-in templates) ----
# AI_PROVIDER=anthropic | gemini   (auto-detected from whichever key is set)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Sending limits (protect your Gmail reputation) ----
DAILY_SEND_LIMIT=40
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=120

# ---- Local testing only ----
# 1 = show a "Dev login" button and simulate Gmail sends (no real emails).
# Only works from localhost. Never enable in production.
DEV_FAKE_AUTH=0
